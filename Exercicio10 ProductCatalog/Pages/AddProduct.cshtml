@page
@model Exercicio10.ProductCatalog.Pages.AddProductModel

@{
    ViewData["Title"] = "Adicionar Produto";
}

<h1>Adicionar Produto</h1>

<form method="post">
    <div style="margin-bottom: 15px;">
        <label>Nome:</label>
        <input asp-for="Nome" />
    </div>

    <div style="margin-bottom: 15px;">
        <label>Preço:</label>
        <input asp-for="Preco" type="number" step="0.01" />
    </div>

    <button type="submit">Cadastrar</button>
</form>

@if (Model.Enviado)
{
    <h2>Produto Cadastrado</h2>
    <p>Nome: @Model.Nome</p>
    <p>Preço: R$ @Model.Preco.ToString("F2")</p>
}