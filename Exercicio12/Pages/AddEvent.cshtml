@page
@model Exercicio12.Pages.AddEventModel

@{
    ViewData["Title"] = "Cadastrar Evento";
}

<h1>Cadastrar Evento</h1>

<form method="post">
    <div style="margin-bottom: 15px;">
        <label>Título:</label>
        <input asp-for="NovoEvento.Titulo" />
    </div>

    <div style="margin-bottom: 15px;">
        <label>Data:</label>
        <input asp-for="NovoEvento.Data" type="date" />
    </div>

    <div style="margin-bottom: 15px;">
        <label>Local:</label>
        <input asp-for="NovoEvento.Local" />
    </div>

    <button type="submit">Cadastrar</button>
</form>